{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Default Sega Saturn build configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "hw-debug",
      "displayName": "HW_DEBUG",
      "description": "Hardware debug build with embedded endless BulletML and direct endless boot",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-hwdebug",
      "cacheVariables": {
        "HW_DEBUG": "ON",
        "HW_DEBUG_ENDLESS_STAGE": "10",
        "SRL_LOG_LEVEL": "WARNING",
        "NOIZ2SA_SHOW_MEMORY_POOLS": "ON",
        "NOIZ2SA_DISABLE_FOECMD_PREALLOC": "OFF",
        "NOIZ2SA_BULLETML_STARTUP_ONLY_POLICY": "ON"
      }
    },
    {
      "name": "profiler",
      "displayName": "Profiler",
      "description": "Release build with the SRL CPU profiler on the gameplay hot path (foes, BulletML, barrages, screen, background); report streamed over the DevCart every 60 frames",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-profiler",
      "cacheVariables": {
        "SRL_PROFILER": "ON",
        "SRL_PROFILER_REPORT_FRAMES": "60",
        "SRL_PROFILER_SAMPLE_HZ": "0",
        "SRL_PROFILE_SOURCES": "src/foe.cc;src/foecommand.cc;src/barragemanager.cc;src/screen.cpp;src/background.cpp"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "hw-debug",
      "configurePreset": "hw-debug"
    },
    {
      "name": "profiler",
      "configurePreset": "profiler"
    }
  ]
}
